# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'InsuranceWizard' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'InsuranceWizardTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Resource bundles such as RNCAsyncStorage_resources still declare 13.4.
    # This Xcode only accepts deployment targets from 15.0 upward.
    minimum_deployment_target = '15.1'
    installer.pods_project.build_configurations.each do |build_config|
      deployment_target = build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
      if deployment_target.nil? || deployment_target.to_f < minimum_deployment_target.to_f
        build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = minimum_deployment_target
      end
    end

    # fmt 11.0.2 builds as C++20 and uses consteval format strings. Apple Clang
    # in Xcode 16.3 and later rejects those calls. C++17 turns that path off.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        deployment_target = build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if deployment_target.nil? || deployment_target.to_f < minimum_deployment_target.to_f
          build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = minimum_deployment_target
        end

        if target.name == 'fmt'
          build_config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        end
      end
    end

    ['debug', 'release'].each do |configuration|
      xcconfig_path = File.join(
        installer.sandbox.root,
        'Target Support Files',
        'fmt',
        "fmt.#{configuration}.xcconfig",
      )
      next unless File.exist?(xcconfig_path)

      contents = File.read(xcconfig_path)
      updated = contents.gsub(
        'CLANG_CXX_LANGUAGE_STANDARD = c++20',
        'CLANG_CXX_LANGUAGE_STANDARD = c++17',
      )
      File.write(xcconfig_path, updated) if updated != contents
    end
  end
end
